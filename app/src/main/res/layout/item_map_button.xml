<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false">

    <TextView
        android:id="@+id/btn_level"
        android:layout_width="@dimen/btn_level_width"
        android:layout_height="@dimen/btn_level_width"
        android:background="@drawable/btn_level"
        android:fontFamily="@font/baloo"
        android:gravity="center"
        android:textColor="@color/brown"
        android:textSize="@dimen/txt_level_size"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/image_level_star"
        android:layout_width="@dimen/image_level_star_width"
        android:layout_height="@dimen/image_level_star_width"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-20dp"
        android:src="@drawable/star_set_bg" />

</FrameLayout>
